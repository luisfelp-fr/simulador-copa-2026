# Renomeie para secrets.toml e preencha com suas chaves (gratuitas).
# As duas seções são OPCIONAIS — sem elas, o app funciona só com entrada manual.

# https://www.football-data.org/  (fonte primária; competição "WC")
[football_data]
token = "SUA_CHAVE_FOOTBALL_DATA"

# https://www.api-football.com/  (reserva; liga 1, season 2026)
[api_football]
key = "SUA_CHAVE_API_FOOTBALL"
